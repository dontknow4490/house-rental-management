# Production / Development Database URL
DATABASE_URL="postgresql://your_db_user:your_db_password@your_db_host:5432/house_rental_db?schema=public"

# Database Service Environment (for Docker Compose)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=house_rental_db

# Server Configuration
PORT=4000
NODE_ENV=production

# Security Guards (ALLOW_DESTRUCTIVE_SEED must remain false in production)
ALLOW_DESTRUCTIVE_SEED=false

# Allowed Frontend URL for CORS (e.g. https://rental.yourdomain.com)
FRONTEND_URL=https://rental.yourdomain.com

# Cryptographically Strong JWT Secret (e.g. generated via `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_min_64_chars
JWT_EXPIRES_IN=7d

# File Storage Configuration (Cloudinary)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial Admin Setup Credentials
INITIAL_ADMIN_USERNAME=your_admin_username
INITIAL_ADMIN_PASSWORD=your_admin_password
