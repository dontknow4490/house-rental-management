# Database Configuration (Docker local PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/house_rental_db?schema=public"

# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Secret for Session & Tokens
JWT_SECRET=replace_with_a_secure_random_key_in_production
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Initial Setup
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_this_password
